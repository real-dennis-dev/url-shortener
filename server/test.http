@host = http://localhost:5000
@contentType = application/json

### ========================
### AUTH ROUTES
### ========================

### 1. Register New User
POST {{host}}/api/auth/register
Content-Type: {{contentType}}

{
  "full_name": "John Doe",
  "email": "johndoe@example.com",
  "username": "johndoe",
  "password": "Password123!"
}


### 2. Login
POST {{host}}/api/auth/login
Content-Type: {{contentType}}

{
  "email": "johndoe@example.com",
  "password": "Password123!"
}


### 3. Get Current User (Protected)
GET {{host}}/api/auth/me
Authorization: Bearer {{token}}


### 4. Refresh Token
POST {{host}}/api/auth/refresh-token
Authorization: Bearer {{token}}


### 5. Logout
POST {{host}}/api/auth/logout
Authorization: Bearer {{token}}


### 6. Logout All Devices
POST {{host}}/api/auth/logout-all
Authorization: Bearer {{token}}


### 7. Resend Verification Email
POST {{host}}/api/auth/resend-verification
Authorization: Bearer {{token}}


### 8. Forgot Password
POST {{host}}/api/auth/forgot-password
Content-Type: {{contentType}}

{
  "email": "johndoe@example.com"
}


### ========================
### ERROR TEST CASES
### ========================

### Register - Missing Fields
POST {{host}}/api/auth/register
Content-Type: {{contentType}}

{
  "email": "test@example.com"
}


### Register - Duplicate Username/Email (after first registration)
POST {{host}}/api/auth/register
Content-Type: {{contentType}}

{
  "full_name": "John Doe",
  "email": "johndoe@example.com",
  "username": "johndoe",
  "password": "Password123!"
}


### Login - Wrong Password
POST {{host}}/api/auth/login
Content-Type: {{contentType}}

{
  "email": "johndoe@example.com",
  "password": "WrongPassword123!"
}


### ========================
### VARIABLES (Save token here after login)
### ========================

@token = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...