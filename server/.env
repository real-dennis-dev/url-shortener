# ==========================================
# Application
# ==========================================

NODE_ENV=development
PORT=5000


# ==========================================
# PostgreSQL Connection Pool
# ==========================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=url-shortener
DB_USER=postgres
DB_PASSWORD=dennis936

DB_POOL_SIZE=20
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=5000

DB_SSL=true
DB_POOL_SIZE=20
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=2000

# false for local development
# true for hosted/remote PostgreSQL when SSL is required
DB_SSL=false

# Email / SMTP
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password

# Sender
EMAIL_FROM=your-email@gmail.com
EMAIL_FROM_NAME=URL Shortener

# Application
BASE_URL=http://localhost:3000

# Optional
EMAIL_TEMPLATE_DIR=../templates/email



# ================================
# STORAGE
# ================================

# Storage provider: local or s3
STORAGE_PROVIDER=local

# Local storage
STORAGE_PATH=./uploads

# S3 configuration
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY_ID=your-access-key
STORAGE_SECRET_ACCESS_KEY=your-secret-key
STORAGE_BUCKET=your-bucket-name

# Optional S3-compatible endpoint
# AWS S3 -> leave empty
# Cloudflare R2, MinIO, etc. -> provide endpoint
STORAGE_ENDPOINT=

# Public URL used when returning uploaded file URLs
STORAGE_BASE_URL=http://localhost:3000/uploads

# Maximum upload size in bytes
# 5242880 = 5MB
STORAGE_MAX_SIZE=5242880

# Allowed MIME types
STORAGE_ALLOWED_TYPES=image/jpeg,image/png,image/gif,image/webp